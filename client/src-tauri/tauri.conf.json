{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PartyLine",
  "mainBinaryName": "parley",
  "version": "0.14.0",
  "identifier": "chat.parley.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PartyLine",
        "width": 1000,
        "height": 680,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "PartyLine",
    "category": "SocialNetworking",
    "shortDescription": "Text and voice chat",
    "longDescription": "PartyLine is a minimal, self-hostable chat app for text and reliable voice chat with your friends.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "net",
        "depends": [
          "libasound2",
          "libssl3"
        ],
        "conflicts": [
          "parley"
        ],
        "replaces": [
          "parley"
        ]
      },
      "rpm": {
        "release": "1",
        "depends": [
          "alsa-lib",
          "openssl-libs"
        ],
        "obsoletes": [
          "parley"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "wix": {
        "upgradeCode": "c9e093ae-0494-5d01-a7c5-fa5620f348d7"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist",
      "signingIdentity": "-"
    }
  }
}
