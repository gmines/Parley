<configuration name="sofia.conf" description="SIP">
  <global_settings>
    <param name="log-level" value="0"/>
  </global_settings>
  <profiles>
    <!-- Only Kamailio talks to this profile, over loopback; Kamailio has
         already authenticated the user. Clients send media to parley_media_ip. -->
    <profile name="parley">
      <settings>
        <param name="sip-ip" value="127.0.0.1"/>
        <param name="sip-port" value="$${parley_sip_port}"/>
        <param name="rtp-ip" value="$${parley_rtp_ip}"/>
        <param name="ext-rtp-ip" value="$${parley_media_ip}"/>
        <param name="context" value="parley"/>
        <param name="dialplan" value="XML"/>
        <param name="auth-calls" value="false"/>
        <param name="disable-register" value="true"/>
        <param name="disable-transfer" value="true"/>
        <param name="manage-presence" value="false"/>
        <param name="inbound-codec-prefs" value="$${parley_codecs}"/>
        <param name="outbound-codec-prefs" value="$${parley_codecs}"/>
        <!-- Pick the codec by our preference (Opus first) among those offered. -->
        <param name="inbound-codec-negotiation" value="greedy"/>
        <!-- Negotiate media when the call is answered, i.e. after the dialplan
             has set rtp_secure_media=mandatory. Without this, FreeSWITCH
             negotiates on INVITE arrival and would accept plain RTP. -->
        <param name="inbound-late-negotiation" value="true"/>
        <param name="enable-timer" value="false"/>
        <!-- Hang up calls whose audio has stopped arriving (dead client, lost network). -->
        <param name="media_timeout" value="30000"/>
        <!-- Send RTCP reports: clients get round-trip time and loss for their
             quality indicator, and Opus adapts its bitrate to reported loss. -->
        <param name="rtcp-audio-interval-msec" value="5000"/>
        <param name="user-agent-string" value="Parley"/>
        <param name="tls" value="false"/>
      </settings>
    </profile>
  </profiles>
</configuration>
