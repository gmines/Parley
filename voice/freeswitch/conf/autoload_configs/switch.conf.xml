<configuration name="switch.conf" description="Core">
  <settings>
    <param name="colorize-console" value="false"/>
    <param name="loglevel" value="info"/>
    <param name="max-sessions" value="2000"/>
    <param name="sessions-per-second" value="100"/>
    <param name="rtp-start-port" value="$${parley_rtp_start}"/>
    <param name="rtp-end-port" value="$${parley_rtp_end}"/>
    <param name="rtp-enable-zrtp" value="false"/>
    <param name="dump-cores" value="no"/>
  </settings>
</configuration>
