<?xml version="1.0"?>
<!-- Parley's minimal FreeSWITCH config: one SIP profile on loopback for
     Kamailio, the "parley" dialplan that parks calls for voice-control,
     and the conference profile used for call rooms. -->
<document type="freeswitch/xml">
  <X-PRE-PROCESS cmd="include" data="vars.xml"/>
  <section name="configuration" description="Modules">
    <X-PRE-PROCESS cmd="include" data="autoload_configs/*.xml"/>
  </section>
  <section name="dialplan" description="Dialplan">
    <X-PRE-PROCESS cmd="include" data="dialplan/*.xml"/>
  </section>
</document>
